  "cards": [
    {
      "dot": "violet",
      "title": "Joining",
      "items": [
        "/xfer mesh up joins the session as one xfer-instance actor keyed by its xfer name",
        "Duplicate names are refused, not auto-renamed — a same-key send would silently route to the first owner"
      ]
    },
    {
      "dot": "cyan",
      "title": "Offline semantics",
      "items": [
        "A node offline when the handoff is sent drains its queue on rejoin",
        "Buffering starts only after the target actor has been created — a never-online target errors after ~30 s"
      ]
    },
    {
      "dot": "amber",
      "title": "Control plane",
      "items": [
        "Rivet Cloud (api.rivet.dev) or a self-hosted engine — both configured through mesh.config.json",
        "Namespace and token may be embedded in the endpoint as URL auth",
        "Check the setup with /xfer doctor — the Mesh line reads the config and queries the engine"
      ]
    }
  ]
