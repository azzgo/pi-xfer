{
  "name": "pi-xfer",
  "version": "0.10.5",
  "description": "Cross-context handoff extension for pi coding agents: structured markdown handoffs over local sockets, cross-machine mesh transport, async board, and web picker.",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "coding-agent",
    "handoff",
    "agent-to-agent",
    "context-transfer",
    "mesh"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azzgo/pi-xfer.git"
  },
  "bugs": {
    "url": "https://github.com/azzgo/pi-xfer/issues"
  },
  "homepage": "https://github.com/azzgo/pi-xfer#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.ts",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "daemon/*.ts",
    "dist/broker.cjs",
    "dist/broker.cjs.sha256",
    "dist/admin.cjs",
    "dist/admin.cjs.sha256",
    "dist/mesh-runtime.cjs",
    "dist/mesh-runtime.cjs.sha256",
    "dist/xfer-adapterd.cjs",
    "dist/xfer-adapterd.cjs.sha256",
    "dist/web-picker.user.js",
    "mcp-gateway.mjs",
    "CONTEXT.md",
    "README.md",
    "LICENSE",
    "skills/"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --import './ts-resolve-hook.mjs' --test './src/**/*.test.ts' './tests/*.test.js'",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "husky": "^9.1.7"
  },
  "overrides": {
    "undici": "^8.12.3"
  }
}
