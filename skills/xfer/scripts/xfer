#!/usr/bin/env node
/**
 * xfer — access layer to the pi-xfer network.
 *
 *   xfer peers              list reachable nodes (local sockets + mesh actors), read-only
 *   xfer <anything else>    delegated verbatim to the xfer-adapterd bundle
 *
 * The bundle is resolved, never hardcoded in callers:
 *   $XFER_BUNDLE  ->  `xfer-adapterd` on PATH  ->  the pi-xfer repo checkout
 *   ->  npm-global pi-xfer  ->  ~/.pi/xfer
 */
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";

const XFER_DIR = process.env.XFER_DIR || path.join(os.homedir(), ".pi", "xfer");
const ACTOR = "xfer-instance";
const MESH_CONFIG = path.join(XFER_DIR, "mesh.config.json");

/** Expand a single `*` per path level and return existing matches. */
function expand(p) {
  const idx = p.indexOf("*");
  if (idx < 0) return fs.existsSync(p) ? [p] : [];
  const dir = path.dirname(p.slice(0, idx + 1));
  const rest = p.slice(idx + 1).replace(/^[/\\]+/, "");
  let entries;
  try {
    entries = fs.readdirSync(dir);
  } catch {
    return [];
  }
  return entries.flatMap((entry) => expand(path.join(dir, entry, rest)));
}

function resolveBundle() {
  const explicit = process.env.XFER_BUNDLE;
  if (explicit) return explicit;
  const home = os.homedir();
  const fixed = [
    path.join(home, "dev", "personal", "pi-xfer", "xfer-adapterd.cjs"),
    path.join(XFER_DIR, "xfer-adapterd.cjs"),
  ];
  const globbed = [
    path.join(home, ".local/share/mise/installs/node/*/lib/node_modules/pi-xfer/xfer-adapterd.cjs"),
    path.join(home, ".nvm/versions/node/*/lib/node_modules/pi-xfer/xfer-adapterd.cjs"),
  ];
  return [...fixed, ...globbed.flatMap(expand)].find((candidate) => fs.existsSync(candidate)) ?? null;
}

function readJson(file) {
  try {
    const raw = JSON.parse(fs.readFileSync(file, "utf-8"));
    return raw && typeof raw === "object" && !Array.isArray(raw) ? raw : null;
  } catch {
    return null;
  }
}

/** Durable, suffix-tolerant node descriptions (`descriptions.json`, v0.4.0). */
function readDescriptions() {
  const store = readJson(path.join(XFER_DIR, "descriptions.json")) || {};
  const out = {};
  for (const [name, entry] of Object.entries(store)) {
    const text = typeof entry === "string" ? entry : entry?.text;
    if (typeof text === "string" && text.trim()) out[name] = text.trim();
  }
  return out;
}

/** Local peers: a read-only filesystem scan, identical to listTargets(). */
function localPeers() {
  let entries;
  try {
    entries = fs.readdirSync(XFER_DIR);
  } catch {
    return [];
  }
  const descriptions = readDescriptions();
  return entries
    .filter((file) => file.endsWith(".sock"))
    .map((sockFile) => {
      const base = sockFile.replace(/\.sock$/, "");
      const meta = readJson(path.join(XFER_DIR, `${base}.json`)) || {};
      const name = typeof meta.xferName === "string" && meta.xferName ? meta.xferName : base;
      const own = typeof meta.description === "string" && meta.description.trim() ? meta.description.trim() : null;
      return {
        name,
        kind: typeof meta.kind === "string" ? meta.kind : "pi",
        status: typeof meta.status === "string" ? meta.status : null,
        cwd: typeof meta.cwd === "string" ? meta.cwd : null,
        description: own || descriptions[name] || null,
      };
    })
    .sort((a, b) => a.name.localeCompare(b.name));
}

/** First key part, mirroring mesh-config.ts deserializeMeshKey (escape-aware). */
function firstKeyPart(serialized) {
  if (!serialized || serialized === "/") return "";
  const parts = [];
  let current = "";
  let escaped = false;
  for (const ch of serialized) {
    if (escaped) {
      current += ch === "0" ? "" : ch;
      escaped = false;
    } else if (ch === "\\") {
      escaped = true;
    } else if (ch === "/") {
      parts.push(current);
      current = "";
    } else {
      current += ch;
    }
  }
  parts.push(current);
  return parts[0] ?? "";
}

/** Actor lifecycle, derived exactly as mesh-engine.ts derives it. */
function actorStatus(actor) {
  if (actor.destroy_ts !== undefined && actor.destroy_ts !== null) return "Destroyed";
  if (actor.error !== undefined && actor.error !== null) return "Crashed";
  if (actor.sleep_ts !== undefined && actor.sleep_ts !== null) return "Sleeping";
  if (actor.connectable_ts !== undefined && actor.connectable_ts !== null) return "Running";
  return "Pending";
}

/** Mesh config, accepting credentials from either the fields or URL userinfo. */
function loadMeshConfig() {
  const raw = readJson(MESH_CONFIG);
  if (!raw) return null;
  let { endpoint, namespace, token } = raw;
  if (typeof endpoint !== "string" || !endpoint.trim()) return null;
  endpoint = endpoint.trim();
  try {
    const url = new URL(endpoint);
    if (url.username || url.password) {
      if (namespace || token) throw new Error("credentials set twice (fields + URL userinfo)");
      namespace = decodeURIComponent(url.username);
      token = decodeURIComponent(url.password);
      url.username = "";
      url.password = "";
      endpoint = url.toString();
    }
  } catch (err) {
    if (/twice/.test(String(err?.message))) throw err;
  }
  return { endpoint, namespace, token, pool: typeof raw.pool === "string" ? raw.pool : null };
}

/** Live engine query — the same read the admin console uses; joins nothing. */
async function meshPeers() {
  const config = loadMeshConfig();
  if (!config) return { state: "unconfigured" };
  const url = new URL("/actors", config.endpoint);
  url.searchParams.set("name", ACTOR);
  if (config.namespace) url.searchParams.set("namespace", config.namespace);
  let response;
  try {
    response = await fetch(url, {
      headers: config.token ? { Authorization: `Bearer ${config.token}` } : {},
      signal: AbortSignal.timeout(10_000),
    });
  } catch (err) {
    return { state: "unreachable", detail: String(err?.message ?? err), pool: config.pool };
  }
  if (!response.ok) {
    return { state: "error", detail: `${response.status} ${await response.text().catch(() => "")}`.trim() };
  }
  const body = await response.json().catch(() => ({}));
  const descriptions = readDescriptions();
  const nodes = (body.actors ?? [])
    .filter((actor) => actor.destroy_ts === undefined || actor.destroy_ts === null)
    .map((actor) => {
      const name = firstKeyPart(typeof actor.key === "string" ? actor.key : "");
      return {
        name,
        actorId: actor.actor_id,
        status: actorStatus(actor),
        pool: actor.runner_name_selector || null,
        description: descriptions[name] || null,
      };
    })
    .sort((a, b) => a.name.localeCompare(b.name));
  return { state: "ok", pool: config.pool, nodes };
}

function pad(text, width) {
  return String(text).padEnd(width);
}

async function peers() {
  const local = localPeers();
  console.log(`LOCAL  ${XFER_DIR}`);
  if (local.length === 0) {
    console.log("  (no sockets — no pi session or adapter daemon is up on this machine)");
  } else {
    const width = Math.max(...local.map((node) => node.name.length), 4);
    for (const node of local) {
      const bits = [node.kind, node.status].filter(Boolean).join("/");
      console.log(`  ${pad(node.name, width)}  ${pad(bits, 14)} ${node.cwd ?? ""}`);
      if (node.description) console.log(`  ${pad("", width)}  ↳ ${node.description}`);
    }
  }

  const mesh = await meshPeers();
  console.log("");
  if (mesh.state === "unconfigured") {
    console.log(`MESH   not configured (no ${MESH_CONFIG})`);
  } else if (mesh.state !== "ok") {
    console.log(`MESH   ${mesh.state}: ${mesh.detail}`);
  } else {
    console.log(`MESH   ${mesh.nodes.length} node(s)${mesh.pool ? `  (this host's pool: ${mesh.pool})` : "  (default pool)"}`);
    if (mesh.nodes.length === 0) {
      console.log("  (none registered under this engine/namespace)");
    } else {
      const width = Math.max(...mesh.nodes.map((node) => node.name.length), 4);
      for (const node of mesh.nodes) {
        console.log(`  ${pad(node.name, width)}  ${pad(node.status, 9)} ${node.pool ? `pool=${node.pool}` : ""}`);
        if (node.description) console.log(`  ${pad("", width)}  ↳ ${node.description}`);
      }
    }
  }
  console.log("");
  console.log("description is self-declared and best-effort — a remote node's note only shows if cached locally.");
}

async function main() {
  const [command, ...rest] = process.argv.slice(2);

  if (command === "peers" || command === "--peers") {
    await peers();
    return;
  }

  const bundle = resolveBundle();
  if (!bundle) {
    console.error(
      "xfer: cannot find xfer-adapterd.cjs — set $XFER_BUNDLE, put `xfer-adapterd` on PATH, " +
        "or keep the pi-xfer checkout at ~/dev/personal/pi-xfer",
    );
    process.exit(1);
  }

  const result = spawnSync(process.execPath, [bundle, ...process.argv.slice(2)], { stdio: "inherit" });
  if (result.error) {
    console.error(`xfer: ${result.error.message}`);
    process.exit(1);
  }
  process.exit(result.status ?? 0);
}

main().catch((err) => {
  console.error(`xfer: ${err?.message ?? err}`);
  process.exit(1);
});
